# Record a burst of motion from a six-axis inertial sensor.
sensor:
  rate_hz: 400
  accel_channels: ["ax", "ay", "az"]
  gyro_channels: ["gx", "gy", "gz"]
  channels: accel_channels + gyro_channels

# The accelerometer's Z axis points up when the mount is level.
mount:
  tilt_deg: 30
  tilt_rad: torad(tilt_deg)
  sensor_to_body: Rot.from_rpy(0, tilt_deg, 0)
  resting_z_m_s2: 9.80665 * cos(tilt_rad)

trigger:
  # Trigger when the Z reading exceeds its resting value by this margin.
  margin_m_s2: 2.0
  z_threshold_m_s2: mount.resting_z_m_s2 + margin_m_s2

recording:
  before_trigger_s: 1
  after_trigger_s: 1
  duration_s: before_trigger_s + after_trigger_s
  interval_ms: 1000 / sensor.rate_hz
  pretrigger_samples: sensor.rate_hz * before_trigger_s
  samples: sensor.rate_hz * duration_s

# Apply calibration and mounting rotation to a simulated pulse along sensor Z.
simulation:
  seed: Rand.seed(42)
  accel_gain: matrix([[1.01, 0, 0], [0, 1, 0], [0, 0, 0.99]])
  sensor_pulse_m_s2: [0, 0, Rand.normal(2, 0.02)]
  body_pulse_m_s2: mount.sensor_to_body * accel_gain * sensor_pulse_m_s2
